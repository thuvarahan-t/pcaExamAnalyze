# ============================================================
#  PCA Exam Analyzer — environment template
#  Copy this file to ".env" and fill in your real values.
#      cp .env.example .env
# ============================================================

# --- Teacher (admin) seed account ---
# Created automatically on first startup if it does not exist. Log in with this username.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=change-this-password
TEACHER_NAME=PCA Teacher

# --- Supabase project/API URLs (optional reference values) ---
SUPABASE_PROJECT_REF=<your-ref>
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_REST_URL=https://<your-ref>.supabase.co/rest/v1

# --- Supabase database (direct PostgreSQL JDBC connection, port 5432) ---
# Do not use SUPABASE_REST_URL here; Spring Data JPA/Hibernate needs JDBC.
DB_URL=jdbc:postgresql://db.<your-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<your-supabase-password>

# No email is used. Students log in with a username + password, and reset a forgotten
# password by entering their NIC. Nothing to configure here.
